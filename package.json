{
  "name": "lumen",
  "version": "0.9.0",
  "description": "Biblia e Himnario Adventista con proyección independiente",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "tauri dev",
    "build": "tsc --noEmit && node scripts/build.mjs && node scripts/prepare-tauri.mjs",
    "start": "tauri dev",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e-tauri.mjs",
    "dist": "tauri build",
    "preview": "vite --host 127.0.0.1",
    "dist:win": "tauri build --bundles nsis",
    "dev:web": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "tauri": "tauri",
    "build:native": "tauri build --no-bundle",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "ffmpeg-static"
    ]
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "fast-xml-parser": "^5.12.1",
    "fflate": "^0.8.3",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "ky": "^2.2.0",
    "lucide": "^1.72.0",
    "usfm-js": "^3.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^26.6.6",
    "electron": "^45.3.2",
    "electron-updater": "^6.8.11",
    "esbuild": "^0.28.2",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "author": "Eliezer Lorenzo y Ezequiel Sierra",
  "repository": {
    "type": "git",
    "url": "https://github.com/elorenzog/lumen.git"
  },
  "homepage": "https://github.com/elorenzog/lumen"
}
